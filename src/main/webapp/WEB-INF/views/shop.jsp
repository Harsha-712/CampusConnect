<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="nav.jspf" %>
<div class="wrap"><h2>Club Shop</h2><p class="ok"><c:out value="${param.msg}"/></p>
<table><tr><th>Item</th><th>Club</th><th>Price</th><th>Stock</th><th></th></tr><c:forEach items="${products}" var="p"><tr><td><a href="${cp}/shop/product?id=${p.id}"><c:out value="${p.name}"/></a></td><td><c:out value="${p.club}"/></td><td>${p.price}</td><td>${p.stock}</td>
<td><form method="post" action="shop"><input type="hidden" name="id" value="${p.id}"><button name="action" value="add">Add to cart</button></form></td></tr></c:forEach></table>
<div class="card"><h3>Cart</h3><table><c:forEach items="${lines}" var="l"><tr><td><c:out value="${l.name}"/></td><td><form method="post" action="shop" style="display:inline"><input type="hidden" name="id" value="${l.id}"><button name="action" value="dec" class="btn sm ghost">-</button> ${l.qty} <button name="action" value="inc" class="btn sm ghost">+</button></form></td><td>${l.line}</td><td><form method="post" action="shop"><input type="hidden" name="id" value="${l.id}"><button name="action" value="remove">Remove</button></form></td></tr></c:forEach></table>
<b>Total: ${sum}</b><form method="post" action="shop" onsubmit="return /^\d{16}$/.test(card.value)||(alert('Enter 16-digit card'),false)"><input type="hidden" name="action" value="checkout"><input name="card" id="card" placeholder="16-digit card (simulated; ending 0000 is declined)"><button>Pay</button></form></div>
<div class="card"><h3>Order history</h3><table><c:forEach items="${orders}" var="o"><tr><td><a href="${cp}/shop/order?id=${o.id}">#${o.id}</a></td><td>${o.total}</td><td>${o.status}</td><td>${o.paymentRef}</td><td>${o.createdAt}</td></tr></c:forEach></table></div></div>
