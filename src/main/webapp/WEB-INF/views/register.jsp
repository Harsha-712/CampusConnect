<%@ page contentType="text/html;charset=UTF-8" %><% request.setAttribute("bare",true); %><%@ include file="nav.jspf" %>
<div class="auth"><div class="l"><h1>Join CampusConnect</h1><p style="font-size:18px;color:#c7d2fe">Create your student account to join clubs, register for events and build your Activity Passport.</p></div>
<div class="r"><div class="box"><h2>Student registration</h2><p class="err"><c:out value="${error}"/></p><p class="err" id="ce" style="display:none"></p>
<form method="post" action="${cp}/register" id="f"><label>Full name</label><input name="name" id="n"><label>Email</label><input name="email" id="e"><div id="es" style="min-height:20px;font-size:13px"></div>
<label>Phone (10 digits)</label><input name="phone" id="ph"><label>Password (8+ chars, letter and digit)</label><input type="password" name="password" id="p"><label>Confirm password</label><input type="password" id="p2"><button id="b" style="width:100%;margin-top:10px">Register</button></form>
<p style="text-align:center">Already registered? <a href="${cp}/login">Login</a></p></div></div></div>
<script>let ok=false,tm;const R=/^[^@\s]+@[^@\s]+\.[^@\s]+$/;e.addEventListener('input',()=>{clearTimeout(tm);const m=e.value.trim();ok=false;if(!R.test(m)){es.textContent='';return}es.innerHTML='<span style="color:#6b7280">Checking…</span>';
 tm=setTimeout(()=>fetch('${cp}/ajax/check-email?email='+encodeURIComponent(m)).then(r=>r.text()).then(t=>{ok=t==='AVAILABLE';es.innerHTML='<span class="'+(ok?'ok':'err')+'">'+(ok?'✓ ':'✗ ')+t+'</span>'}),300)});
f.onsubmit=()=>{let m='';if(n.value.trim().length<2)m='Name is required';else if(!R.test(e.value))m='Invalid email';else if(!/^\d{10}$/.test(ph.value))m='Phone must be 10 digits';else if(!/^(?=.*[A-Za-z])(?=.*\d).{8,}$/.test(p.value))m='Password needs 8+ characters with a letter and a digit';else if(p.value!==p2.value)m='Passwords do not match';else if(!ok)m='Email is not available';
 if(m){ce.textContent=m;ce.style.display='block';return false}b.disabled=true;b.textContent='Creating…';return true}</script>
