<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="nav.jspf" %>
<div class="wrap"><h2>Manage Events</h2><p class="ok"><c:out value="${param.msg}"/></p><p class="err" id="ce" style="display:none"></p>
<div class="card"><h3>${empty ev?'Create event':'Edit event'}</h3><form method="post" action="${cp}/coordinator/events" id="f"><input type="hidden" name="action" value="${empty ev?'create':'update'}"><input type="hidden" name="id" value="${ev.id}">
<c:if test="${empty ev}"><select name="clubId"><c:forEach items="${clubs}" var="c"><option value="${c.id}"><c:out value="${c.name}"/></option></c:forEach></select></c:if>
<input name="title" id="t" placeholder="Title" value="<c:out value='${ev.title}'/>"><input name="description" placeholder="Description" value="<c:out value='${ev.description}'/>" style="width:300px"><br>
<label>Date</label> <input type="date" name="date" id="d" value="${ev.eventDate}"> <label>Time</label> <input type="time" name="time" id="tm" value="${ev.eventTime}"> <input name="location" id="l" placeholder="Location" value="<c:out value='${ev.location}'/>"><br>
<label>Register by</label> <input type="date" name="deadline" id="dl" value="${ev.regDeadline}"> <input name="capacity" id="cap" placeholder="Capacity" value="${ev.capacity}"><button>${empty ev?'Create':'Save changes'}</button> <c:if test="${not empty ev}"><a class="btn ghost" href="${cp}/coordinator/events">Cancel edit</a></c:if></form></div>
<div class="card"><table><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th><th>Regs</th><th>Code</th><th></th></tr><c:forEach items="${events}" var="e"><tr><td><c:out value="${e.title}"/></td><td>${e.eventDate} ${e.eventTime}</td><td><c:out value="${e.location}"/></td><td><span class="badge ${e.state=='OPEN'?'ok':e.state=='CANCELLED'?'err':'warn'}">${e.state}</span></td><td>${e.taken}/${e.capacity}</td><td>${e.code}</td>
<td><a class="btn sm ghost" href="?edit=${e.id}">Edit</a> <c:if test="${e.state!='CANCELLED'}"><form method="post" action="${cp}/coordinator/events" style="display:inline"><input type="hidden" name="action" value="cancel"><input type="hidden" name="id" value="${e.id}"><button class="btn sm ghost" onclick="return confirm('Cancel this event?')">Cancel event</button></form></c:if></td></tr></c:forEach></table></div></div>
<script>f.onsubmit=()=>{const m=t.value.trim().length<3?'Title is too short':!d.value?'Choose a date':!tm.value?'Choose a time':!l.value.trim()?'Location required':!dl.value||dl.value>d.value?'Deadline must be on/before event date':!/^[1-9]\d*$/.test(cap.value)?'Capacity must be positive':'';if(m){ce.textContent=m;ce.style.display='block';return false}return true}</script>
