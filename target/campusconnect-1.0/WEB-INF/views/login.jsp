<%@ page contentType="text/html;charset=UTF-8" %><% request.setAttribute("bare",true); %><%@ include file="nav.jspf" %>
<div class="auth"><div class="l"><h1>🎓 CampusConnect</h1><p style="font-size:18px;color:#c7d2fe">One platform for every college club: memberships, events, attendance, certificates and your verified Activity Passport.</p>
<div class="demo"><b>Demo accounts</b> <small>(password123) — click to fill</small><a href="#" onclick="fill('student@campus.edu')">🎓 student@campus.edu</a><a href="#" onclick="fill('coord@campus.edu')">⚙ coord@campus.edu</a><a href="#" onclick="fill('faculty@campus.edu')">📋 faculty@campus.edu</a><a href="#" onclick="fill('admin@campus.edu')">🛡 admin@campus.edu</a></div></div>
<div class="r"><div class="box"><h2>Welcome back</h2><p class="err"><c:out value="${error}"/></p><p class="err" id="ce" style="display:none"></p>
<form method="post" action="${cp}/login" id="f"><label>Email</label><input name="email" id="e" type="email" value="<c:out value='${email}'/>" autocomplete="username"><label>Password</label><div class="pw"><input type="password" name="password" id="p" autocomplete="current-password"><span onclick="tg()" id="t">Show</span></div>
<label style="font-weight:400"><input type="checkbox" name="remember" style="width:auto" ${not empty email?'checked':''}> Remember my email</label><br><button id="b" style="width:100%;margin-top:8px">Login</button></form><p style="text-align:center">New student? <a href="${cp}/register">Create account</a></p></div></div></div>
<script>function fill(m){e.value=m;p.value='password123';return false}function tg(){p.type=p.type=='password'?'text':'password';t.textContent=p.type=='password'?'Show':'Hide'}
f.onsubmit=()=>{const x=ce;if(!/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(e.value)){x.textContent='Enter a valid email address';x.style.display='block';return false}if(!p.value){x.textContent='Enter your password';x.style.display='block';return false}b.disabled=true;b.textContent='Signing in…';return true}</script>
