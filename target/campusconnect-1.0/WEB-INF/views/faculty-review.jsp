<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="nav.jspf" %>
<div class="wrap"><h2>Faculty Review</h2><p class="ok"><c:out value="${param.msg}"/></p>
<div class="card"><h3>Major activity proposals</h3><table><c:forEach items="${proposals}" var="p"><tr><td><b><c:out value="${p.title}"/></b><br><small><c:out value="${p.description}"/></small></td><td><c:out value="${p.club}"/></td><td><span class="badge ${p.status=='APPROVED'?'ok':p.status=='PENDING'?'warn':'err'}">${p.status}</span></td>
<td><c:if test="${p.status=='PENDING'}"><form method="post" action="review"><input type="hidden" name="id" value="${p.id}"><button name="action" value="approve" class="btn sm">Approve</button> <button name="action" value="reject" class="btn sm ghost">Reject</button></form></c:if></td></tr></c:forEach></table></div>
<div class="card"><h3>Events &amp; attendance</h3><table><tr><th>Event</th><th>Club</th><th>Date</th><th>Registered</th><th>Attended</th></tr><c:forEach items="${events}" var="e"><tr><td><c:out value="${e.title}"/></td><td><c:out value="${e.club}"/></td><td>${e.event_date}</td><td>${e.regs}</td><td>${e.att}</td></tr></c:forEach></table></div>
<div class="card"><h3>Recent certificates</h3><table><c:forEach items="${certs}" var="c"><tr><td><c:out value="${c.studentName}"/></td><td><c:out value="${c.title}"/></td><td>${c.issuedOn}</td></tr></c:forEach></table></div></div>
