<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="nav.jspf" %>
<div class="wrap"><h2>${title}</h2><p class="${param.ok=='1'?'ok':'err'}"><c:out value="${param.msg}"/></p>
<form method="get" action="${cp}/admin/users"><input type="hidden" name="role" value="${targetRole}"><input name="s" placeholder="Search name or email" value="<c:out value='${param.s}'/>"><button>Search</button></form>
<div class="card"><table><tr><th>Name</th><th>Email</th><th>Phone</th><th>Status</th><th></th></tr><c:forEach items="${items}" var="u"><tr><td><c:out value="${u.name}"/></td><td><c:out value="${u.email}"/></td><td><c:out value="${u.phone}"/></td><td><span class="badge ${u.status=='Active'?'ok':'err'}">${u.status}</span></td>
<td><form method="post" action="${cp}/admin/users"><input type="hidden" name="action" value="toggle"><input type="hidden" name="id" value="${u.id}"><input type="hidden" name="role" value="${targetRole}"><button class="btn sm ghost" onclick="return confirm('Change status?')">Activate / Deactivate</button></form></td></tr></c:forEach></table><c:if test="${empty items}"><div class="empty">No users found</div></c:if></div>
<c:if test="${targetRole!='STUDENT'}"><div class="card"><h3>Add user</h3><form method="post" action="${cp}/admin/users"><input type="hidden" name="action" value="add"><input type="hidden" name="role" value="${targetRole}"><input name="name" placeholder="Name" required><input name="email" type="email" placeholder="Email" required><input name="phone" placeholder="Phone"><input name="password" type="password" minlength="8" placeholder="Password (8+)" required><button>Add</button></form></div></c:if></div>
