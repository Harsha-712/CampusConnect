<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="nav.jspf" %>
<div class="wrap"><h2>Product Management</h2><p class="ok"><c:out value="${param.msg}"/></p>
<div class="card"><table><tr><th>Product</th><th>Club</th><th>Category</th><th>Price</th><th>Stock</th><th></th></tr><c:forEach items="${items}" var="p"><tr><td><b><c:out value="${p.name}"/></b><br><small><c:out value="${p.description}"/></small></td><td><c:out value="${p.club}"/></td><td><c:out value="${p.category}"/></td>
<form method="post" action="${cp}/admin/products"><td><input name="price" type="number" step="0.01" min="0" value="${p.price}" style="width:90px"></td><td><input name="stock" type="number" min="0" value="${p.stock}" style="width:80px"></td><td><input type="hidden" name="id" value="${p.id}"><button name="action" value="update" class="btn sm">Save</button> <button name="action" value="delete" class="btn sm ghost" onclick="return confirm('Delete product?')">Delete</button></td></form></tr></c:forEach></table></div>
<div class="card"><h3>Add product</h3><form method="post" action="${cp}/admin/products"><input type="hidden" name="action" value="add"><select name="clubId"><c:forEach items="${clubs}" var="c"><option value="${c.id}"><c:out value="${c.name}"/></option></c:forEach></select><input name="name" placeholder="Name" required><input name="category" value="Merchandise"><input name="description" placeholder="Description"><input name="price" type="number" step="0.01" min="0" placeholder="Price" required><input name="stock" type="number" min="0" placeholder="Stock" required><button>Add</button></form></div></div>
