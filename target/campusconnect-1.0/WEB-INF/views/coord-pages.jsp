<%@ page contentType="text/html;charset=UTF-8" %><%@ include file="nav.jspf" %>
<div class="wrap"><h2>${title}</h2><p class="ok"><c:out value="${param.msg}"/></p>
<c:if test="${view=='proposals'}"><div class="card"><h3>Submit activity for faculty approval</h3><form method="post" action="proposals"><select name="clubId"><c:forEach items="${clubs}" var="c"><option value="${c.id}"><c:out value="${c.name}"/></option></c:forEach></select><input name="title" placeholder="Title" required><input name="description" placeholder="Description" style="width:300px"><button>Submit</button></form></div></c:if>
<div class="card"><table><c:forEach items="${items}" var="i"><tr><c:choose>
<c:when test="${view=='members'}"><td><c:out value="${i.name}"/></td><td><c:out value="${i.email}"/></td><td><c:out value="${i.club}"/></td><td>${i.joined_at}</td></c:when>
<c:when test="${view=='attendance'}"><td><c:out value="${i.title}"/></td><td><c:out value="${i.name}"/></td><td><span class="badge ${i.status=='PRESENT'?'ok':'warn'}">${i.status}</span></td><td><c:if test="${i.status!='PRESENT'}"><form method="post" action="attendance"><input type="hidden" name="eventId" value="${i.event_id}"><input type="hidden" name="userId" value="${i.user_id}"><button class="btn sm">Mark present</button></form></c:if></td></c:when>
<c:otherwise><td><b><c:out value="${i.title}"/></b><br><small><c:out value="${i.description}"/></small></td><td><c:out value="${i.club}"/></td><td><span class="badge ${i.status=='APPROVED'?'ok':i.status=='PENDING'?'warn':'err'}">${i.status}</span></td></c:otherwise></c:choose></tr></c:forEach></table><c:if test="${empty items}"><div class="empty">Nothing here yet</div></c:if></div></div>
